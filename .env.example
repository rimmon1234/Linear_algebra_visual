# Environment Configuration Template
# Copy this file to .env.local for local development.
# Never commit real secrets, private keys, or .env.local to version control.

# ==============================================================================
# Public Client Variables (Exposed to the browser via NEXT_PUBLIC_ prefix)
# ==============================================================================

# Base URL of the application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (Required for Milestone 10: Persistence & Auth)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# Server-Only Variables (NEVER expose to the browser or prefix with NEXT_PUBLIC_)
# ==============================================================================

# Supabase Service Role Key (Elevated privileges, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider API Configuration (Required for Milestone 6: AI Playground)
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=

# Observability / Error Monitoring (Optional, Pre-Launch)
ERROR_MONITORING_DSN=
